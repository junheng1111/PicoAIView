# PicoClaw 环境变量配置
# 复制到 /etc/picoclaw/picoclaw.env 后由 systemd 加载

# --- LLM Provider ---
PICOCLAW_LLM=minimax         # claude | openai | minimax
PICOCLAW_LLM_MODEL=MiniMax-Text-01   # MiniMax 模型名，可按需改为 abab7.5-chat 等

# MiniMax
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_BASE=https://api.minimax.chat/v1   # OpenAI 兼容地址
# MINIMAX_GROUP_ID=你的第一方GroupID  # 部分接口需要

# Anthropic Claude（备用，切到 claude 时启用）
# PICOCLAW_LLM=claude
# ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI（备用，切到 openai 时启用）
# PICOCLAW_LLM=openai
# OPENAI_API_KEY=sk-xxx

# --- 模型路径 ---
PICOCLAW_MODEL_DIR=/root/pico_view/models
PICOCLAW_DETECT_BIN=/root/pico_view/models/yolov8s_detect_bayese_640x640_nv12.bin
PICOCLAW_POSE_BIN=/root/pico_view/models/yolov8s_pose_bayese_640x640_nv12.bin
# PICOCLAW_SEG_BIN=/root/pico_view/models/yolov8s_seg_bayese_640x640_nv12.bin
# PICOCLAW_DEPTH_BIN=/root/pico_view/models/fast_depth_224x224_nv12.bin
# PICOCLAW_FACE_BIN=/root/pico_view/models/scrfd_2.5g_bnkps_640x640_nv12.bin

# --- 摄像头 ---
PICOCLAW_CAM_W=1920
PICOCLAW_CAM_H=1080
PICOCLAW_CAM_FPS=30

# --- 上传 / 缓存目录 ---
PICOCLAW_UPLOAD_DIR=/tmp/picoclaw/uploads
PICOCLAW_CACHE_DIR=/tmp/picoclaw/cache
